[sub_resource type="GDScript" id="GDScript_8pk1l"]
resource_name = "Bible"
script/source = "extends Label3D

var BIBLIA_ALMEIDA : String = \"res://data/biblia_almeida.csv\"
var bible : Array[Array]

var current_verse : int = 0

func _ready() -> void:
	var f = FileAccess.open(BIBLIA_ALMEIDA,FileAccess.READ)
	f.get_csv_line() # Excludes first row (Header)
	##Verse ID|Book Name|Book Number|Chapter|Verse|Text##
	while not f.eof_reached():
		var line := Array(f.get_csv_line())
		bible.append(line)

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"Gear Up\"):
		current_verse += 1
		set_verse(current_verse)
	elif event.is_action_pressed(\"Gear Down\"):
		current_verse -= 1
		set_verse(current_verse)

func set_verse(verse_id : int) -> void:
	text = bible[verse_id][5]
	
"

