[sub_resource type="GDScript" id="GDScript_58w0b"]
script/source = "extends Node3D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	# Zero Gravity
	PhysicsServer3D.area_set_param(get_viewport().find_world_3d().space, PhysicsServer3D.AREA_PARAM_GRAVITY, 0.0)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	var gravity = (position - Global.Player.position).normalized()
	
	Global.Player.apply_central_force(gravity * 15000 * delta) 
	Global.Player.gravity_direction = -gravity
"

