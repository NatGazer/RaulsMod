[sub_resource type="GDScript" id="GDScript_getpj"]
resource_name = "Boids"
script/source = "extends MultiMeshInstance3D

func _ready() -> void:
	multimesh.instance_count = 0
	multimesh.buffer.clear()
	multimesh.instance_count = 1000
	multimesh.buffer.clear()
	for idx in multimesh.instance_count:
		var boid_position := Vector3(randf_range(-2, 2), randf_range(-2, 2), randf_range(-2, 2))
		var boid_orientation := Basis(Quaternion.from_euler(Vector3(randf_range(0.0, TAU), randf_range(0.0, TAU), randf_range(0.0, TAU))))
		multimesh.set_instance_transform(idx, Transform3D(boid_orientation, boid_position))

func _physics_process(delta: float) -> void:
	for idx in multimesh.instance_count:
		var boid_transf : Transform3D = multimesh.get_instance_transform(idx)
		
		boid_transf.origin += -boid_transf.basis.z.normalized() * delta
		
		multimesh.set_instance_transform(idx, boid_transf)
	
	
"

