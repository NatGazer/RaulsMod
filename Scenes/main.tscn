[sub_resource type="GDScript" id="GDScript_7k868"]
resource_name = "FractureManager"
script/source = "extends MeshInstance3D

func _ready() -> void:
	for voronoi_collection in get_parent().get_children():
		if voronoi_collection is VoronoiCollection:
			for rb in voronoi_collection.get_children():
				if rb is RigidBody3D:
					if randf() > 0.4:
						rb.mass = 5 #kg
						rb.freeze = true
						rb.sleeping = true
"

