[sub_resource type="GDScript" id="GDScript_dg77c"]
resource_name = "WakoSpawner"
script/source = "extends Node3D

@export var wako : PackedScene

func _ready() -> void:
	for i in range(100):
		var angle = randf_range(-PI, PI)
		var radius = sqrt(randf()) * 10
		var wako_instance = wako.instantiate()
		wako_instance.position = position + Vector3(sin(angle), 0, cos(angle)) * radius
		add_child(wako_instance)
"

