[sub_resource type="GDScript" id="GDScript_n7h83"]
resource_name = "LegsManager"
script/source = "extends Node

@export var legs : Array[Node3D]
@export var base_step_time : float = 0.2
@export var base_step_distance : float = 2.0
@export_group(\"User Input\")
@export var move_speed : float = 100

var step_time : float = base_step_time
var step_distance : float = base_step_distance
var timer : float = 0.0
var user_input : bool = false

func _ready() -> void:
	if legs.size() < 2:
		printerr(\"Assign Legs to LegManager!\")

func _physics_process(delta: float) -> void:
	step_distance = base_step_distance * 1/max(1, 0.5*%SpiderBody.linear_velocity.length())
	
	timer += delta
	if timer < step_time: return
	
	var r_leg_id : int
	var r_biggest_step : float = 0.0
	var l_leg_id : int
	var l_biggest_step : float = 0.0
	for i in legs.size():
		if legs[i].side == 0:
			if l_biggest_step < legs[i].dist_to_target():
				l_biggest_step = legs[i].dist_to_target()
				l_leg_id = i
		elif legs[i].side == 1:
			if r_biggest_step < legs[i].dist_to_target():
				r_biggest_step = legs[i].dist_to_target()
				r_leg_id = i
		
		legs[i].set_target_shift_pos(_shift_target(delta))
		
	
	var l_step_length_ratio : float = l_biggest_step / step_distance
	if legs[l_leg_id].is_on_ground and (l_step_length_ratio > 1 or user_input):
		legs[l_leg_id].step(step_time)
		timer = 0.0
	
	var r_step_length_ratio : float = r_biggest_step / step_distance
	if legs[r_leg_id].is_on_ground and (r_step_length_ratio > 1 or user_input):
		legs[r_leg_id].step(step_time)
		timer = 0.0
	
	step_time = base_step_time / (l_step_length_ratio*0.5 + r_step_length_ratio*0.5)



func _shift_target(delta : float) -> Vector3:
	#var forward : float = Input.get_axis(\"ui_down\", \"ui_up\")
	var forward : float = 1
	user_input = forward != 0
	return -%SpiderBody.basis.z * forward * move_speed * delta
"

