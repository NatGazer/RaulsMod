[sub_resource type="GDScript" id="GDScript_ljj2s"]
resource_name = "IK_BodyMotion"
script/source = "extends RigidBody3D

@export var legs : Array[Node3D]
@export var ground_height : float = 1.3 # m
@export var move_speed : float = 100
@export var turn_speed : float = 10

var old_force : Vector3
var target_pos_ki : Vector3 = Vector3.ZERO

var stiffness : float = 10e4
var damping : float = 3e5

var rotational_stiffness : float = 5e4
var rotational_damping : float = 4e3

func _ready() -> void:
	if legs.size() < 3:
		printerr(\"Kinematic Body needs at least three legs assigned!\")

func _physics_process(delta: float) -> void:
	## Return if Spider not touching ground
	for leg in legs:
		if not leg.is_on_ground:
			#return
			pass
	
	## Compute Target Basis
	var leg_positions: PackedVector3Array
	for leg in legs: leg_positions.append(leg.target_pos())
	var legs_normal : Vector3 = _get_best_fit_plane_normal(leg_positions)
	var target_basis : Basis = _basis_from_normal(legs_normal)
	
	## Compute Target Position
	var avg_leg_pos := Vector3.ZERO
	for leg_pos in leg_positions: avg_leg_pos += leg_pos
	avg_leg_pos /= legs.size()
	var target_pos : Vector3 = avg_leg_pos + target_basis.y * ground_height
	
	## Movement
	var target := Transform3D(target_basis, target_pos)
	target = _movement_to_target_shift(target, delta)
	target_basis = target.basis
	target_pos = target.origin
	%BodyTarget.global_transform = target
	
	## Desired Torque from Target Basis (with damping)
	# Calculate the axis-by-axis error using the cross product.
	# This creates a torque vector that tries to correct the misalignment.
	var torque : Vector3 = (global_basis.x.cross(target_basis.x)+
							global_basis.y.cross(target_basis.y)+
							global_basis.z.cross(target_basis.z))
	torque *= rotational_stiffness
	var damping_torque : Vector3 = angular_velocity * rotational_damping
	apply_torque(torque - damping_torque)
	
	## Desired Force from Target Position (with  relative damping)
	var force : Vector3 = (target_pos-global_position)
	var target_pos_kd : Vector3 = old_force - force
	apply_central_force(force*stiffness - target_pos_kd*damping)
	old_force = force

# Returns the normal of the 3D plane that best fits the given set of points.
func _get_best_fit_plane_normal(points: PackedVector3Array) -> Vector3:
	# A plane is not well-defined with fewer than 3 points.
	if points.size() < 3:
		printerr(\"Cannot find a best-fit plane for less than 3 points.\")
		return Vector3.ZERO

	# 1. Calculate the centroid (average position) of the point cloud.
	var centroid := Vector3.ZERO
	for p in points:
		centroid += p
	centroid /= points.size()

	# 2. Calculate the 3x3 covariance matrix.
	# We can use Godot's Basis object to store it.
	var covariance_matrix := Basis(Vector3.ZERO, Vector3.ZERO, Vector3.ZERO)
	for p in points:
		var rel_p: Vector3 = p - centroid
		covariance_matrix.x.x += rel_p.x * rel_p.x
		covariance_matrix.x.y += rel_p.x * rel_p.y
		covariance_matrix.x.z += rel_p.x * rel_p.z
		covariance_matrix.y.y += rel_p.y * rel_p.y
		covariance_matrix.y.z += rel_p.y * rel_p.z
		covariance_matrix.z.z += rel_p.z * rel_p.z
	
	# The matrix is symmetric, so we can fill in the other elements.
	covariance_matrix.y.x = covariance_matrix.x.y
	covariance_matrix.z.x = covariance_matrix.x.z
	covariance_matrix.z.y = covariance_matrix.y.z

	# 3. Find the eigenvector corresponding to the smallest eigenvalue.
	# We can use the Inverse Power Iteration method, which is efficient for this.
	# It repeatedly multiplies a random vector by the inverse of the matrix.
	var inv_matrix := covariance_matrix.inverse()
	if inv_matrix == Basis(Vector3.ZERO, Vector3.ZERO, Vector3.ZERO): # Matrix is singular (e.g., points are co-linear)
		printerr(\"Failed to find plane normal. Points may be co-linear.\")
		# In this case, there are infinite planes, so we can't find a single best one.
		return Vector3.ZERO

	var eigenvector := Vector3(1.0, 1.0, 1.0).normalized() # Start with a random vector

	# Iterate a few times to converge on the eigenvector.
	# For a 3x3 matrix, 10-15 iterations is usually more than enough.
	for i in range(15):
		eigenvector = (inv_matrix * eigenvector).normalized()

	return eigenvector

func _basis_from_normal(normal: Vector3) -> Basis:
	var result := Basis()
	result.x = normal.cross(transform.basis.z)
	result.y = normal
	result.z = transform.basis.x.cross(normal)
	
	result = result.orthonormalized()
	result.x *= scale.x
	result.y *= scale.y
	result.z *= scale.z
	return result.orthonormalized()
	
func _movement_to_target_shift(target : Transform3D,  delta : float) -> Transform3D:
	var forward : float = Input.get_axis(\"ui_down\", \"ui_up\")
	target.origin -= forward * move_speed * delta * target.basis.z
	
	var side_rotation : float = Input.get_axis(\"ui_right\", \"ui_left\")
	target.basis = target.basis.rotated(Vector3(0, 1, 0), side_rotation * turn_speed * delta)

	return target
"

