[sub_resource type="GDScript" id="GDScript_5p2b4"]
resource_name = "BibleReader"
script/source = "extends VBoxContainer

var BIBLIA_ALMEIDA : String = \"res://data/biblia_almeida.csv\"
var bible : Array[Array]

var current_verse : int = 0

func _ready() -> void:
	var err : bool = try_load_parsed_bible()
	if err: parse_bible()
	
	# Randomize Start Point
	#current_verse = randi_range(0, bible.size()-2)
	
	await get_tree().create_timer(2).timeout
	start_reading()

func try_load_parsed_bible() -> bool:
	var load_file = FileAccess.open(\"user://bible.tres\", FileAccess.READ)
	if not load_file: return true
	
	var loaded_var : Variant = load_file.get_var()
	if loaded_var is not Array[Array]: return true
	
	bible = loaded_var
	load_file.close()
	
	return false

func parse_bible() -> void:
	var f = FileAccess.open(BIBLIA_ALMEIDA,FileAccess.READ)
	
	f.get_csv_line() # Excludes first row (Header)
	##Verse ID|Book Name|Book Number|Chapter|Verse|Text##
	
	while not f.eof_reached():
		var line := Array(f.get_csv_line())
		bible.append(line)
	
	var save_file = FileAccess.open(\"user://bible.tres\", FileAccess.WRITE)
	save_file.store_var(bible)
	save_file.close()

var read_tween : Tween
func start_reading() -> void:
	set_verse()
	
	if read_tween: read_tween.kill()
	read_tween = get_tree().create_tween()
	
	# 0.07s per character (minimum 5 seconds)
	read_tween.tween_interval(maxf(5, bible[current_verse][5].length() * 0.07))
	read_tween.tween_callback(start_reading)
	
	current_verse += 1


var fade_tween : Tween
func set_verse() -> void:
	if current_verse < 0:
		current_verse = bible.size()-2
	elif current_verse > bible.size()-2:
		current_verse = 0
	
	var line : Array = bible[current_verse]
	var verse : String = line[5]
	var chapter_location : String =  line[1] + \" \" + line[3] + \":\" + line[4]
	
	if fade_tween: fade_tween.kill()
	fade_tween = get_tree().create_tween()
	
	fade_tween.tween_property($Verse, \"modulate:a\", 0, 0.5)
	fade_tween.parallel()
	fade_tween.tween_property($ChapterNumbers, \"modulate:a\", 0, 0.5)
	
	if verse.length() > 180:
		fade_tween.tween_property($Verse, \"label_settings:font_size\", 30, 0.0)
	else:
		fade_tween.tween_property($Verse, \"label_settings:font_size\", 40, 0.0)
	
	fade_tween.tween_property($Verse, \"text\", verse, 0.0)
	fade_tween.tween_property($ChapterNumbers, \"text\", chapter_location, 0.0)
	
	fade_tween.tween_property($Verse, \"modulate:a\", 1.0, 1.8)
	fade_tween.tween_interval(0.4)
	fade_tween.tween_property($ChapterNumbers, \"modulate:a\", 1.0, 1.2)
	
"

