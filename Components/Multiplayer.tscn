[gd_scene load_steps=4 format=3 uid="uid://c6d0so1bwk0g7"]

[ext_resource type="PackedScene" uid="uid://cw45fu5tnjto1" path="res://Components/MultiplayerPlayer.tscn" id="1_3vlfo"]

[sub_resource type="GDScript" id="GDScript_5pk2l"]
resource_name = "UI_Multiplayer"
script/source = "extends VBoxContainer


func _on_server_pressed() -> void:
	NetworkHandler.start_server()


func _on_client_pressed() -> void:
	NetworkHandler.start_client()
"

[sub_resource type="GDScript" id="GDScript_3vlfo"]
resource_name = "MultiplayerSpawner"
script/source = "extends MultiplayerSpawner

@export var network_player: PackedScene

func _ready() -> void:
	multiplayer.peer_connected.connect(spawn_player)

func spawn_player(id : int) -> void:
	# Only add player to server (this node automatically adds it to clients)
	if not multiplayer.is_server(): return
	
	# Create player and give it id name
	var player : Node = network_player.instantiate()
	player.name = str(id)
	
	# Add player to spawn_path (the place were nodes are replicated to clients)
	get_node(spawn_path).call_deferred(\"add_child\", player)
"

[node name="Multiplayer" type="Node"]

